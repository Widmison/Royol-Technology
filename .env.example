# Copy to `.env` locally. On Vercel: Project → Settings → Environment Variables.

# --- PostgreSQL ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Non-pooled URL for prisma migrate / CLI (Supabase: port 5432 session; pooled often :6543)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# PG_POOL_MAX="1"

# --- NextAuth ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- REQUIRED ON VERCEL / PRODUCTION: admin email OTP hashing (≥16 chars) ---
# openssl rand -hex 32
MEX509_ADMIN_OTP_PEPPER="replace-with-long-random-secret"

# --- Public site / portal URLs ---
NEXT_PUBLIC_SITE_URL="https://example.com"
# NEXT_PUBLIC_PORTAL_URL="https://portal.example.com"
# MEX509_PORTAL_HOST="portal.example.com"

# --- Admin portal (email links; optional) ---
# MEX509_ADMIN_HOST="admin.example.com"

# --- Staff bootstrap (first admin login path) ---
# Prefer MEX509_ADMIN_DEFAULT_PASSWORD; legacy MEX509_ADMIN_PASSWORD still supported.
# MEX509_ADMIN_DEFAULT_PASSWORD="long-random-bootstrap-password"

# --- Payments ---
MEX509_PAYMENT_SECRET="long-random-hex-or-string"

# --- Email (Resend) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="Brand <noreply@example.com>"

# --- Optional ---
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="..."
# AUTH_COOKIE_DOMAIN=".example.com"
# MEX509_ADMIN_NOTIFY_EMAIL="ops@example.com"

# --- Google admin sign-in (optional; enable all three) ---
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# --- Client portal: WhatsApp OTP (optional — Twilio WhatsApp sender) ---
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Pickup photo uploads (optional) ---
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."
