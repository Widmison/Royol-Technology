generator client {
  provider = "prisma-client-js"
}

// ✅ PERFECT FOR PRISMA 7: URLs are moved to prisma.config.ts!
datasource db {
  provider = "postgresql"
}

// 1. USERS (Admin Staff & Registered Clients)
model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  role             Role              @default(CLIENT)
  firstName        String?
  lastName         String?
  
  // ==========================
  // NEW: PHONE NUMBER FIELD
  // ==========================
  phone            String?           

  // ==========================
  // ADDRESS FIELDS
  // ==========================
  address          String?
  city             String?
  state            String?
  zipCode          String?

  // ==========================
  // VERIFICATION FIELDS
  // ==========================
  isVerified       Boolean           @default(false)
  verificationCode String?

  createdAt        DateTime          @default(now())
  requests         ShipmentRequest[] // A client can have many pre-registered shipments
}

enum Role {
  ADMIN
  CLIENT
}

// 2. PRE-REGISTRATION / QUOTE FORM (What they fill out online)
model ShipmentRequest {
  id               String        @id @default(cuid())
  firstName        String
  lastName         String
  phone            String
  departure        String
  category         String
  description      String
  shippingMethod      String
  destinationCountry  String? // Delivery country (quote step 2)
  address             String
  state               String
  city                String
  zipCode             String
  clientId         String?       // Optional: if they are logged in
  client           User?         @relation(fields: [clientId], references: [id])
  status           RequestStatus @default(PENDING_DROPOFF)
  invoice          Invoice?      // Will be created when weighed at the office
  package          Package?      // Will be created after payment
  createdAt        DateTime      @default(now())
}

enum RequestStatus {
  PENDING_DROPOFF   // Submitted online, waiting for client to arrive at office
  RECEIVED_WEIGHING // Client is at office, admin is weighing it
  INVOICED          // Admin generated the price
  PAID              // Client paid, ready to ship!
}

// 3. INVOICES (Generated by Admin after weighing)
model Invoice {
  id               String          @id @default(cuid())
  requestId        String          @unique
  request          ShipmentRequest @relation(fields: [requestId], references: [id])
  actualWeightLbs  Float           // Entered by Admin
  totalAmount      Float           // Entered by Admin
  status           InvoiceStatus   @default(UNPAID)
  createdAt        DateTime        @default(now())
  paidAt           DateTime?
}

enum InvoiceStatus {
  UNPAID
  PAID
}

// 4. ACTUAL PACKAGES (Created at warehouse intake with invoice; payment clears for dispatch)
model Package {
  id            String          @id @default(cuid())
  trackingId    String          @unique // e.g., MEX987654321
  requestId     String          @unique
  request       ShipmentRequest @relation(fields: [requestId], references: [id])
  status        PackageStatus   @default(PROCESSING)
  events        TrackingEvent[] // The history timeline
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum PackageStatus {
  PROCESSING
  IN_TRANSIT
  CUSTOMS
  READY_FOR_PICKUP
  DELIVERED
}

// 5. TRACKING EVENTS (Updates added by Admin that trigger emails)
model TrackingEvent {
  id          String        @id @default(cuid())
  packageId   String
  package     Package       @relation(fields: [packageId], references: [id])
  status      PackageStatus
  location    String        // e.g., "Miami Warehouse", "Port-au-Prince"
  description String?       // e.g., "Cleared customs, ready for delivery"
  date        DateTime      @default(now())
}