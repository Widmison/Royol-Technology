generator client {
  provider = "prisma-client-js"
}

// ✅ PERFECT FOR PRISMA 7: URLs are moved to prisma.config.ts!
datasource db {
  provider = "postgresql"
}

// 1. USERS (Admin Staff & Registered Clients)
model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  role             Role              @default(CLIENT)
  firstName        String?
  lastName         String?
  
  // ==========================
  // NEW: PHONE NUMBER FIELD
  // ==========================
  phone            String?           

  // ==========================
  // ADDRESS FIELDS
  // ==========================
  address          String?
  city             String?
  state            String?
  zipCode          String?

  // ==========================
  // VERIFICATION FIELDS
  // ==========================
  isVerified       Boolean           @default(false)
  verificationCode String?

  passwordResetToken   String?
  passwordResetExpires DateTime?

  /** Admin portal: Web Dev vs Admin team (clients ignore this field). */
  adminStaffRole        AdminStaffRole?
  /** False until staff finish the onboarding profile form (email/password path). */
  adminProfileComplete  Boolean           @default(true)

  // ==========================
  // PHASE 2: Admin TOTP (Google Authenticator) — ADMIN only in app logic
  // ==========================
  /** Base32 TOTP shared secret; null until enrolled or if 2FA disabled. */
  twoFactorSecret    String?
  twoFactorEnabled   Boolean           @default(false)

  // ==========================
  // PHASE 2: Referrals — clients get a shareable code; optional referrer link
  // ==========================
  /** Unique code for CLIENT users (share/rewards); null for ADMIN/STAFF until needed. */
  referralCode       String?           @unique
  referredById       String?
  referrer           User?             @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers      User[]            @relation("UserReferrals")
  pickupRequests     PickupRequest[]

  createdAt        DateTime          @default(now())
  requests         ShipmentRequest[] // A client can have many pre-registered shipments
  externalTrackings ClientExternalTracking[]
  appNotifications AppNotification[]

  @@index([referredById])
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum AdminStaffRole {
  WEB_DEV
  ADMIN_TEAM
}

/** Single-use email codes for admin password sign-in (sent every login). */
model AdminLoginOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/**
 * Emails allowed to use the admin portal (sign-in + Google OAuth bootstrap).
 * Managed in Settings by Web Dev only — replaces the old hardcoded registry.
 */
model StaffAllowlistEntry {
  id        String         @id @default(cuid())
  email     String         @unique
  staffRole AdminStaffRole
  roleLabel String         @default("")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([staffRole])
}

// 2. PRE-REGISTRATION / QUOTE FORM (What they fill out online)
model ShipmentRequest {
  id               String        @id @default(cuid())
  firstName        String
  lastName         String
  phone            String
  departure        String
  category         String
  description      String
  shippingMethod      String
  destinationCountry  String? // Delivery country (quote step 2)
  address             String
  state               String
  city                String
  zipCode             String
  clientId         String?       // Optional: if they are logged in
  client           User?         @relation(fields: [clientId], references: [id])
  status           RequestStatus @default(PENDING_DROPOFF)
  invoice          Invoice?      // Will be created when weighed at the office
  package          Package?      // Will be created after payment
  createdAt        DateTime      @default(now())
  /** Optional 1:1 from home/office pickup after the package enters normal tracking. */
  linkedFromPickup PickupRequest? @relation("ShipmentFromPickup")
}

enum RequestStatus {
  PENDING_DROPOFF   // Submitted online, waiting for client to arrive at office
  RECEIVED_WEIGHING // Client is at office, admin is weighing it
  INVOICED          // Admin generated the price
  PAID              // Client paid, ready to ship!
}

// 3. INVOICES (Generated by Admin after weighing)
model Invoice {
  id               String          @id @default(cuid())
  requestId        String          @unique
  request          ShipmentRequest @relation(fields: [requestId], references: [id])
  actualWeightLbs  Float           // Entered by Admin
  totalAmount      Float           // Entered by Admin
  status           InvoiceStatus   @default(UNPAID)
  createdAt        DateTime        @default(now())
  paidAt           DateTime?
  /** e.g. CARD, NATCASH, MONCASH — set when marked paid */
  paidVia          String?
}

enum InvoiceStatus {
  UNPAID
  PAID
}

// 4. ACTUAL PACKAGES (Created at warehouse intake with invoice; payment clears for dispatch)
model Package {
  id            String          @id @default(cuid())
  trackingId    String          @unique // e.g., MEX987654321
  requestId     String          @unique
  request       ShipmentRequest @relation(fields: [requestId], references: [id])
  status        PackageStatus   @default(PROCESSING)
  events        TrackingEvent[] // The history timeline
  linkedExternalTrackings ClientExternalTracking[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum PackageStatus {
  PROCESSING
  IN_TRANSIT
  CUSTOMS
  READY_FOR_PICKUP
  DELIVERED
  RECEIVED_USA_WAREHOUSE
  PROCESSING_SORTING_USA
  IN_TRANSIT_USA_TO_DR
  CUSTOMS_DR_ENTRY
  ARRIVED_RD_WAREHOUSE
  PREPARING_HAITI_TRANSFER
  IN_TRANSIT_RD_TO_HT
  CUSTOMS_HT_ENTRY
  ARRIVED_HT_MAIN_WAREHOUSE
  EN_ROUTE_CAP_HAITIEN
  EN_ROUTE_HINCHE
  EN_ROUTE_PORT_AU_PRINCE
}

// 5. TRACKING EVENTS (Updates added by Admin that trigger emails)
model TrackingEvent {
  id          String        @id @default(cuid())
  packageId   String
  package     Package       @relation(fields: [packageId], references: [id])
  status      PackageStatus
  location    String        // e.g., "Miami Warehouse", "Port-au-Prince"
  description String?       // e.g., "Cleared customs, ready for delivery"
  date        DateTime      @default(now())
}

/** Third-party ecommerce tracking numbers clients add from Amazon, Shein, etc. — staff can link to internal MEX packages. */
model ClientExternalTracking {
  id              String                   @id @default(cuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeLabel      String?
  carrier         String?
  trackingNumber  String
  notes           String?
  status          ExternalTrackingStatus   @default(PENDING_REVIEW)
  linkedPackageId String?
  linkedPackage   Package?                 @relation(fields: [linkedPackageId], references: [id])

  @@index([linkedPackageId])
  adminNote       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([userId])
  @@index([status])
}

enum ExternalTrackingStatus {
  PENDING_REVIEW
  PACKED_RECEIVED
}

/** In-app notifications for clients (userId set) and staff (forStaff true). */
model AppNotification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  forStaff  Boolean   @default(false)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([forStaff, createdAt])
}

// ==========================
// REQUEST PICKUP (client → admin review, optional distance-based price)
// ==========================
enum PickupRequestStatus {
  PENDING    // received; admin sets/sends price
  PRICE_SENT // client notified
  CONFIRMED  // client accepted; pickup scheduled
  PICKED_UP  // can link to ShipmentRequest for normal tracking
  CANCELLED
}

/**
 * Home/office pickup: name, address, phone, package photo; admin may override auto (per mile) price.
 * After PICKED_UP, optionally create/link a ShipmentRequest for standard tracking.
 */
model PickupRequest {
  id       String  @id @default(cuid())
  clientId String?
  client   User?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name     String
  phone    String
  address  String
  city     String?
  state    String?
  zipCode  String?

  /** Set after upload (Vercel Blob, etc.) in Phase 3. */
  packagePhotoUrl String?

  originLabel      String? // e.g. "Miami WH"
  destinationLabel String? // e.g. "Orlando, FL"
  distanceMiles    Float?
  pricePerMile     Float?
  autoTotalAmount  Float?
  adminOverrideTotalAmount Float?
  /** What was communicated to the client. */
  finalQuotedAmount        Float?

  status    PickupRequestStatus @default(PENDING)
  adminNote String?

  linkedShipmentRequestId String?  @unique
  linkedShipmentRequest  ShipmentRequest? @relation("ShipmentFromPickup", fields: [linkedShipmentRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status, createdAt])
}